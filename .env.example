# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/notifier

# GitHub API
# Optional. Without a token the API rate limit is 60 req/h per IP.
# Required for private repositories or higher rate limits (5000 req/h).
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN=

# SMTP (email transport)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=your_smtp_password
# Address that appears in the "From" field of sent emails
SMTP_FROM=noreply@example.com

# Application
# Base URL used to build confirmation and unsubscribe links in emails
BASE_URL=http://localhost:3000
