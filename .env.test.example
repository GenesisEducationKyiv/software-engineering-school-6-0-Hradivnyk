# Test database — matches docker-compose.test.yml db-test service
DATABASE_URL=postgresql://test:test@localhost:5433/test_db
NODE_ENV=test

# SMTP — required by config even though email is mocked in tests
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=test@example.com
SMTP_PASS=test
SMTP_FROM=noreply@test.example.com

# API key used in integration tests
API_KEY=test-api-key
